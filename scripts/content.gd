extends Node
## Immutable definitions. Relics and weapons are generated by
## tools/make_content.py; every other family is a canonical, hand-edited JSON
## file under content/. Records are converted to typed runtime values once and
## validated before use: unknown handlers, duplicate IDs and missing references
## are rejected rather than silently falling back to another behavior.
var items: Array = []
var weapons: Array = []
var item_by_id: Dictionary = {}
var weapon_by_id: Dictionary = {}
var families: Dictionary = {}
var by_id: Dictionary = {}
var revision := ""
var errors := PackedStringArray()
const RARITY_COLORS = {"common": Color("c6d3bf"), "uncommon": Color("96d9ba"), "rare": Color("b9b2e9"), "mythic": Color("f1c579")}
const CATALOG_PATH := "res://assets/data.json"
const FAMILY_DIR := "res://content/"
const FAMILIES := ["rooms", "furniture", "pickups", "actives", "drop_tables"]
# Extra record lists that live in a family's file.
const EXTRA_LISTS := {"furniture": ["layouts"]}
const PROP_RECIPES := ["pillar", "table", "chair", "bookcase", "bench", "cupboard", "crate", "barrel", "jar", "brazier",
	"wall_shelf", "book_pile", "rug", "partition", "workbench", "cot", "painting_frame"]
const PROP_PLACEMENTS := ["floor", "center", "companion", "wall", "cluster", "scatter", "mount"]
# Registered behaviour. Data may only name these; it never names scripts or
# methods, and an unknown name is a validation error rather than a fallback.
const PICKUP_KINDS := ["coin", "heal", "ward", "key", "bomb", "battery", "battery_full"]
const PICKUP_VISUALS := ["coin", "heart", "ward", "key", "bomb", "battery"]
const ACTIVE_HANDLERS := {"heal": ["amount"], "gale": ["radius", "push"], "ember_burst": ["count", "damage", "speed"],
	"slow_field": ["duration", "slow", "boss_slow"], "modifier": ["duration", "effects"], "companions": ["count", "duration", "damage"],
	"secret_hint": ["duration"], "invulnerable": ["duration"]}
# Drop kinds written by version 1 saves, resolved explicitly.
const LEGACY_PICKUPS := {"coin": "copper_coin", "heart": "half_heart"}

func _ready() -> void:
	load_catalog()
	for error in errors:
		push_error("Content: " + error)

func load_catalog() -> void:
	errors = PackedStringArray()
	var digest_source := ""
	var catalog_text = FileAccess.get_file_as_string(CATALOG_PATH)
	digest_source += catalog_text
	var data = JSON.parse_string(catalog_text)
	if not data is Dictionary:
		errors.append("%s is not valid JSON" % CATALOG_PATH)
		data = {"items": [], "weapons": []}
	items = data.get("items", [])
	weapons = data.get("weapons", [])
	item_by_id.clear()
	weapon_by_id.clear()
	for item in items:
		item_by_id[item.id] = item
	for weapon in weapons:
		weapon_by_id[weapon.id] = weapon
	families.clear()
	by_id.clear()
	for family in FAMILIES:
		var path = FAMILY_DIR + family + ".json"
		var text = FileAccess.get_file_as_string(path) if FileAccess.file_exists(path) else ""
		digest_source += text
		var parsed = JSON.parse_string(text) if text != "" else null
		if not parsed is Dictionary or not parsed.get(family) is Array:
			errors.append("%s is missing or does not contain a '%s' list" % [path, family])
			parsed = {family: []}
		ingest(family, parsed[family])
		for extra in EXTRA_LISTS.get(family, []):
			ingest(extra, parsed.get(extra, []) if parsed.get(extra) is Array else [])
	errors.append_array(validate())
	revision = "%08x" % stable_hash(digest_source)

## Replaces one family's records. Tests use this to prove broken data is rejected.
func ingest(family: String, raw_records: Array) -> void:
	families[family] = []
	by_id[family] = {}
	for raw in raw_records:
		var converted = convert_record(family, raw)
		if converted.is_empty():
			continue
		if by_id[family].has(converted.id):
			errors.append("%s: duplicate id '%s'" % [family, converted.id])
			continue
		families[family].append(converted)
		by_id[family][converted.id] = converted

## Converts a JSON record to typed runtime values. Structural problems become
## errors and the record is skipped, so later code can trust its fields.
func convert_record(family: String, raw) -> Dictionary:
	if not raw is Dictionary or not raw.get("id") is String or raw.id.is_empty():
		errors.append("%s: record without a string id" % family)
		return {}
	var record: Dictionary = raw.duplicate(true)
	match family:
		"rooms":
			record.cells = to_cells(raw.get("cells", []))
			record.rotations = raw.get("rotations", [0]).map(func(r): return int(r))
			record.revision = int(raw.get("revision", 1))
			record.weight = float(raw.get("weight", 1))
			record.lights = raw.get("lights", []).map(func(value): return to_anchor(value))
			record.pedestal = to_anchor(raw.get("pedestal", [0, 0, 0, 0]))
	return record

func validate() -> PackedStringArray:
	var problems := PackedStringArray()
	var valid_stats = base_stats()
	for item in items:
		for key in item.effects:
			if not valid_stats.has(key): problems.append("relic %s uses unknown effect '%s'" % [item.id, key])
	for weapon in weapons:
		for key in weapon.effects:
			if not valid_stats.has(key): problems.append("weapon %s uses unknown effect '%s'" % [weapon.id, key])
	for template in families.get("rooms", []):
		problems.append_array(validate_template(template))
	for prop in families.get("furniture", []):
		problems.append_array(validate_prop(prop))
	for layout in families.get("layouts", []):
		problems.append_array(validate_layout(layout))
	for pickup in families.get("pickups", []):
		problems.append_array(validate_pickup(pickup))
	for active in families.get("actives", []):
		problems.append_array(validate_active(active))
	for table in families.get("drop_tables", []):
		problems.append_array(validate_drop_table(table))
	return problems

static func is_number(value) -> bool:
	return value is float or value is int

func validate_prop(prop: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if prop.get("recipe") not in PROP_RECIPES: problems.append("prop %s has unknown visual recipe '%s'" % [prop.id, prop.get("recipe")])
	if prop.get("placement") not in PROP_PLACEMENTS: problems.append("prop %s has unknown placement '%s'" % [prop.id, prop.get("placement")])
	var size = prop.get("size", [])
	if not size is Array or size.size() != 2 or not is_number(size[0]) or not is_number(size[1]) or size[0] <= 0 or size[1] <= 0:
		problems.append("prop %s has an invalid footprint" % prop.id)
	if not is_number(prop.get("height")) or prop.height <= 0: problems.append("prop %s needs a positive height" % prop.id)
	if prop.get("detail") not in ["essential", "decor"]: problems.append("prop %s has an unknown detail class" % prop.id)
	# Lowering Small details may hide decoration, never collision or loot.
	if prop.get("detail") == "decor" and (prop.get("solid", false) or prop.has("breakable")):
		problems.append("decorative prop %s cannot be solid or breakable" % prop.id)
	if prop.get("blocks_shots", false) and not prop.get("solid", false): problems.append("prop %s blocks shots but is not solid" % prop.id)
	if prop.has("breakable"):
		var breakable = prop.breakable
		if not is_number(breakable.get("health")) or breakable.health <= 0: problems.append("prop %s needs positive break health" % prop.id)
		if not by_id.get("drop_tables", {}).has(breakable.get("drops", "")): problems.append("prop %s names missing drop table '%s'" % [prop.id, breakable.get("drops", "")])
		if not prop.get("blocks_shots", false): problems.append("breakable prop %s must be hittable" % prop.id)
	return problems

func validate_layout(layout: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	for role in layout.get("roles", []):
		if role not in ROOM_ROLES: problems.append("layout %s has unknown role '%s'" % [layout.id, role])
	for piece in layout.get("pieces", []):
		if not by_id.get("furniture", {}).has(piece.get("prop", "")): problems.append("layout %s names missing prop '%s'" % [layout.id, piece.get("prop", "")])
		var count = piece.get("count", [])
		if not count is Array or count.size() != 2 or count[0] < 0 or count[0] > count[1]: problems.append("layout %s has an impossible count" % layout.id)
		for companion in piece.get("with", []):
			if not by_id.get("furniture", {}).has(companion): problems.append("layout %s names missing companion '%s'" % [layout.id, companion])
	return problems

func validate_pickup(pickup: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if pickup.get("kind") not in PICKUP_KINDS: problems.append("pickup %s has unknown kind '%s'" % [pickup.id, pickup.get("kind")])
	if pickup.get("visual") not in PICKUP_VISUALS: problems.append("pickup %s has unknown visual '%s'" % [pickup.id, pickup.get("visual")])
	if not is_number(pickup.get("value")) or pickup.value <= 0: problems.append("pickup %s needs a positive value" % pickup.id)
	if pickup.has("cap") and (not is_number(pickup.cap) or pickup.cap < pickup.get("value", 0)): problems.append("pickup %s has an impossible cap" % pickup.id)
	if not Color.html_is_valid(str(pickup.get("color", ""))): problems.append("pickup %s has an invalid color" % pickup.id)
	return problems

func validate_active(active: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var handler = active.get("handler", "")
	if not ACTIVE_HANDLERS.has(handler):
		problems.append("active %s has unknown handler '%s'" % [active.id, handler])
		return problems
	if str(active.get("name", "")).is_empty() or str(active.get("description", "")).is_empty(): problems.append("active %s needs a name and description" % active.id)
	if not is_number(active.get("cooldown")) or active.cooldown <= 0: problems.append("active %s needs a positive cooldown" % active.id)
	var cost = active.get("cost", {})
	if not cost is Dictionary:
		problems.append("active %s has a malformed cost" % active.id)
	else:
		for resource in cost:
			if resource != "coins": problems.append("active %s costs an unknown resource '%s'" % [active.id, resource])
			elif not is_number(cost[resource]) or cost[resource] < 0 or cost[resource] > 99 or float(cost[resource]) != floorf(cost[resource]):
				problems.append("active %s has an impossible cost" % active.id)
	var params = active.get("params", {})
	for key in ACTIVE_HANDLERS[handler]:
		if not params.has(key): problems.append("active %s handler %s needs param '%s'" % [active.id, handler, key])
	if handler == "modifier":
		for stat in params.get("effects", {}):
			if not base_stats().has(stat): problems.append("active %s modifies unknown stat '%s'" % [active.id, stat])
	if not Color.html_is_valid(str(active.get("color", ""))): problems.append("active %s has an invalid color" % active.id)
	return problems

func validate_drop_table(table: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var rolls = table.get("rolls", [])
	if not rolls is Array or rolls.is_empty():
		problems.append("drop table %s has no rolls" % table.id)
		return problems
	for roll in rolls:
		var shapes = ["coins", "pickup", "one_of", "active"].filter(func(key): return roll.has(key))
		if shapes.size() != 1:
			problems.append("drop table %s has a roll that is not exactly one kind" % table.id)
			continue
		if roll.has("chance") and (not is_number(roll.chance) or roll.chance < 0 or roll.chance > 1): problems.append("drop table %s has an impossible chance" % table.id)
		if roll.has("count") and (not is_number(roll.count) or roll.count < 1): problems.append("drop table %s has an impossible count" % table.id)
		if roll.has("pickup") and not by_id.get("pickups", {}).has(roll.pickup): problems.append("drop table %s names missing pickup '%s'" % [table.id, roll.pickup])
		if roll.has("coins") and (not is_number(roll.coins) or roll.coins <= 0): problems.append("drop table %s has an impossible coin amount" % table.id)
		if roll.has("active") and (not is_number(roll.active) or roll.active < 0 or roll.active > 1): problems.append("drop table %s has an impossible active chance" % table.id)
		for choice in roll.get("one_of", []):
			if not by_id.get("pickups", {}).has(choice.get("pickup", "")): problems.append("drop table %s names missing pickup '%s'" % [table.id, choice.get("pickup", "")])
			if not is_number(choice.get("weight")) or choice.weight <= 0: problems.append("drop table %s has a non-positive weight" % table.id)
	return problems

func validate_template(template: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var cells: Array = template.cells
	if cells.is_empty():
		problems.append("room %s has no footprint cells" % template.id)
		return problems
	var seen := {}
	for cell in cells:
		if seen.has(cell): problems.append("room %s repeats cell %s" % [template.id, cell])
		seen[cell] = true
	# Every cell must join the others through a shared edge.
	var reached := {cells[0]: true}
	var queue: Array = [cells[0]]
	while not queue.is_empty():
		var at: Vector2i = queue.pop_back()
		for step in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			if seen.has(at + step) and not reached.has(at + step):
				reached[at + step] = true
				queue.append(at + step)
	if reached.size() != seen.size(): problems.append("room %s footprint is not edge-connected" % template.id)
	if template.rotations.is_empty(): problems.append("room %s allows no rotation" % template.id)
	for rotation in template.rotations:
		if rotation < 0 or rotation > 3: problems.append("room %s has invalid rotation %d" % [template.id, rotation])
	if template.weight <= 0: problems.append("room %s has no generation weight" % template.id)
	for role in template.get("roles", []):
		if role not in ROOM_ROLES: problems.append("room %s has unknown role '%s'" % [template.id, role])
	for anchor in template.lights + [template.pedestal]:
		if not seen.has(anchor.cell): problems.append("room %s anchor lies outside its footprint" % template.id)
	return problems

const ROOM_ROLES := ["start", "combat", "treasure", "shop", "rest", "boss", "secret"]

static func to_cells(values: Array) -> Array:
	var result: Array = []
	for value in values:
		result.append(Vector2i(int(value[0]), int(value[1])))
	return result

## [cell x, cell y, u, v]; u/v are -1..1 fractions of the cell half extents.
static func to_anchor(value: Array) -> Dictionary:
	return {"cell": Vector2i(int(value[0]), int(value[1])), "offset": Vector2(float(value[2]), float(value[3]))}

func record(family: String, id: String) -> Dictionary:
	return by_id.get(family, {}).get(id, {})

## Stable 32-bit FNV-1a, used for named seed streams and content revisions.
## Unlike engine hashing it is documented and identical on every platform.
static func stable_hash(text: String) -> int:
	var value := 2166136261
	for byte in text.to_utf8_buffer():
		value = ((value ^ byte) * 16777619) & 0xffffffff
	return value

func roll_items(rng: RandomNumberGenerator, count: int, owned: Array = [], premium := false, luck_value := 0.0) -> Array:
	var result: Array = []
	var pool: Array = items.duplicate()
	for unused in count:
		var weights: Array[float] = []
		var total = 0.0
		for item in pool:
			var weight: float = {"common": 6.0, "uncommon": 3.5, "rare": 1.2, "mythic": 0.25}[item.rarity]
			if premium and item.rarity in ["rare", "mythic"]:
				weight *= 4.0
			if item.rarity in ["rare", "mythic"]:
				weight *= 1.0 + maxf(0, luck_value) * .3
			if item.id in owned:
				weight *= 0.25
			total += weight
			weights.append(total)
		var roll = rng.randf() * total
		for i in pool.size():
			if roll <= weights[i]:
				result.append(pool.pop_at(i))
				break
	return result

func base_stats() -> Dictionary:
	return {"damage": 1.0, "rate": 1.0, "speed": 1.0, "max_hp": 6.0,
		"shot_speed": 1.0, "range": 1.0, "shots": 0.0, "pierce": 0.0,
		"bounce": 0.0, "homing": 0.0, "burn": 0.0, "chill": 0.0,
		"poison": 0.0, "chain": 0.0, "explosion": 0.0, "split": 0.0,
		"size": 1.0, "crit": 0.05, "crit_damage": 2.0, "lifesteal": 0.0,
		"shield": 0.0, "orbitals": 0.0, "luck": 0.0, "magnet": 1.6,
		"dash_cd": 0.0, "dash_damage": 0.0, "dash_nova": 0.0,
		"thorns": 0.0, "coin_bonus": 0.0, "room_heal": 0.0,
		"kill_haste": 0.0, "low_hp": 0.0, "execute": 0.0,
		"knockback": 1.0, "backshot": 0.0, "side_shot": 0.0,
		"returning": 0.0, "wave": 0.0, "radial": 0.0, "heal_each_room": 0.0}
