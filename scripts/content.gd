extends Node
## Immutable definitions. Relics and weapons are generated by
## tools/make_content.py; every other family is a canonical, hand-edited JSON
## file under content/. Records are converted to typed runtime values once and
## validated before use: unknown handlers, duplicate IDs and missing references
## are rejected rather than silently falling back to another behavior.
var items: Array = []
var weapons: Array = []
var item_by_id: Dictionary = {}
var weapon_by_id: Dictionary = {}
var families: Dictionary = {}
var by_id: Dictionary = {}
var revision := ""
var errors := PackedStringArray()
const RARITY_COLORS = {"common": Color("c6d3bf"), "uncommon": Color("96d9ba"), "rare": Color("b9b2e9"), "mythic": Color("f1c579"), "dark": Color("b98ae0")}
const CATALOG_PATH := "res://assets/data.json"
const FAMILY_DIR := "res://content/"
const FAMILIES := ["rooms", "furniture", "pickups", "actives", "drop_tables", "effects", "paintings", "collections", "floors"]
const SOURCE_TYPES := {"commons": "file", "nga": "object", "met": "object", "aic": "object"}
const EFFECT_CHANNELS := ["important", "atmosphere", "ambient"]
const EFFECT_SPREADS := ["sphere", "up", "ring", "forward"]
# Extra record lists that live in a family's file.
const EXTRA_LISTS := {"furniture": ["layouts"], "floors": ["climbs", "twists"]}
const PROP_RECIPES := ["pillar", "table", "chair", "bookcase", "bench", "cupboard", "crate", "barrel", "jar", "brazier",
	"wall_shelf", "book_pile", "rug", "partition", "workbench", "cot", "painting_frame"]
const PROP_PLACEMENTS := ["floor", "center", "companion", "wall", "cluster", "scatter", "mount"]
# Registered behaviour. Data may only name these; it never names scripts or
# methods, and an unknown name is a validation error rather than a fallback.
const PICKUP_KINDS := ["coin", "heal", "ward", "key", "bomb", "battery", "battery_full"]
const PICKUP_VISUALS := ["coin", "heart", "ward", "key", "bomb", "battery"]
const ACTIVE_HANDLERS := {"heal": ["amount"], "gale": ["radius", "push"], "ember_burst": ["count", "damage", "speed"],
	"slow_field": ["duration", "slow", "boss_slow"], "modifier": ["duration", "effects"], "companions": ["count", "duration", "damage"],
	"secret_hint": ["duration"], "invulnerable": ["duration"]}
# A floor theme's place in the climb, the hazard it lays in its rooms, and
# the twists a floor can draw. A climb lists bands (one theme each, never
# repeated) or a fixed order of themes.
const FLOOR_BANDS := ["first", "middle", "summit"]
const FLOOR_HAZARDS := ["", "water", "wax", "frost", "vents", "pendulums"]
const FLOOR_TWISTS := ["dim", "overgrown", "gilded", "flooded", "swarming", "restless", "windswept"]
const FLOOR_LIGHT_KEYS := ["ambient_color", "key_color", "lamp_color", "background", "fog_color"]
const FLOOR_LOOK_KEYS := ["wall", "cap", "base", "under", "motes"]
# Drop kinds written by version 1 saves, resolved explicitly.
const LEGACY_PICKUPS := {"coin": "copper_coin", "heart": "half_heart"}

func _ready() -> void:
	load_catalog()
	for error in errors:
		push_error("Content: " + error)

func load_catalog() -> void:
	errors = PackedStringArray()
	var digest_source := ""
	var catalog_text = FileAccess.get_file_as_string(CATALOG_PATH)
	digest_source += catalog_text
	var data = JSON.parse_string(catalog_text)
	if not data is Dictionary:
		errors.append("%s is not valid JSON" % CATALOG_PATH)
		data = {"items": [], "weapons": []}
	items = data.get("items", [])
	weapons = data.get("weapons", [])
	item_by_id.clear()
	weapon_by_id.clear()
	for item in items:
		item_by_id[item.id] = item
	for weapon in weapons:
		weapon_by_id[weapon.id] = weapon
	families.clear()
	by_id.clear()
	for family in FAMILIES:
		var path = FAMILY_DIR + family + ".json"
		var text = FileAccess.get_file_as_string(path) if FileAccess.file_exists(path) else ""
		digest_source += text
		var parsed = JSON.parse_string(text) if text != "" else null
		if not parsed is Dictionary or not parsed.get(family) is Array:
			errors.append("%s is missing or does not contain a '%s' list" % [path, family])
			parsed = {family: []}
		ingest(family, parsed[family])
		for extra in EXTRA_LISTS.get(family, []):
			ingest(extra, parsed.get(extra, []) if parsed.get(extra) is Array else [])
	errors.append_array(validate())
	revision = "%08x" % stable_hash(digest_source)

## Summary for packaged-build checks: what loaded, and which painting files
## are bundled versus still awaiting import.
func report() -> Dictionary:
	var counts := {}
	for family in families:
		counts[family] = families[family].size()
	var imported: Array = []
	var missing: Array = []
	for painting in families.get("paintings", []):
		if painting.asset.status != "imported": continue
		if ResourceLoader.exists(painting.asset.wall) and ResourceLoader.exists(painting.asset.full): imported.append(painting.id)
		else: missing.append(painting.id)
	return {"revision": revision, "errors": errors, "families": counts, "relics": items.size(), "weapons": weapons.size(),
		"paintings_imported": imported, "paintings_missing": missing}

## Replaces one family's records. Tests use this to prove broken data is rejected.
func ingest(family: String, raw_records: Array) -> void:
	families[family] = []
	by_id[family] = {}
	for raw in raw_records:
		var converted = convert_record(family, raw)
		if converted.is_empty():
			continue
		if by_id[family].has(converted.id):
			errors.append("%s: duplicate id '%s'" % [family, converted.id])
			continue
		families[family].append(converted)
		by_id[family][converted.id] = converted

## Converts a JSON record to typed runtime values. Structural problems become
## errors and the record is skipped, so later code can trust its fields.
func convert_record(family: String, raw) -> Dictionary:
	if not raw is Dictionary or not raw.get("id") is String or raw.id.is_empty():
		errors.append("%s: record without a string id" % family)
		return {}
	var record: Dictionary = raw.duplicate(true)
	match family:
		"rooms":
			record.cells = to_cells(raw.get("cells", []))
			record.rotations = raw.get("rotations", [0]).map(func(r): return int(r))
			record.revision = int(raw.get("revision", 1))
			record.weight = float(raw.get("weight", 1))
			record.lights = raw.get("lights", []).map(func(value): return to_anchor(value))
			record.pedestal = to_anchor(raw.get("pedestal", [0, 0, 0, 0]))
		"floors":
			if raw.get("roster") is Array:
				record.roster = raw.roster.map(func(entry): return [str(entry[0]), float(entry[1]), int(entry[2])] if entry is Array and entry.size() == 3 else [])
	return record

func validate() -> PackedStringArray:
	var problems := PackedStringArray()
	var valid_stats = base_stats()
	for item in items:
		for key in item.effects:
			if not valid_stats.has(key): problems.append("relic %s uses unknown effect '%s'" % [item.id, key])
		if not RARITY_COLORS.has(item.get("rarity", "")): problems.append("relic %s has unknown rarity '%s'" % [item.id, item.get("rarity")])
		# Dark relics are bought with 2-5 half-hearts of maximum health; nothing else has a price of its own.
		if item.get("rarity") == "dark" and (not is_number(item.get("cost")) or item.cost < 2 or item.cost > 5): problems.append("dark relic %s needs a cost of 2-5 half-hearts" % item.id)
		elif item.get("rarity") != "dark" and item.has("cost"): problems.append("relic %s has a dark price but is not dark" % item.id)
	for weapon in weapons:
		for key in weapon.effects:
			if not valid_stats.has(key): problems.append("weapon %s uses unknown effect '%s'" % [weapon.id, key])
		if weapon.has("requires") and not by_id.get("collections", {}).has(weapon.requires):
			problems.append("weapon %s requires missing collection '%s'" % [weapon.id, weapon.requires])
		for entry in weapon.get("cycle", []):
			if not Color.html_is_valid(str(entry.get("color", ""))): problems.append("weapon %s has an invalid pigment color" % weapon.id)
			for key in entry.get("effects", {}):
				if not valid_stats.has(key): problems.append("weapon %s pigment uses unknown effect '%s'" % [weapon.id, key])
	for painting in families.get("paintings", []):
		problems.append_array(validate_painting(painting))
	for collection in families.get("collections", []):
		problems.append_array(validate_collection(collection))
	for template in families.get("rooms", []):
		problems.append_array(validate_template(template))
	for prop in families.get("furniture", []):
		problems.append_array(validate_prop(prop))
	for layout in families.get("layouts", []):
		problems.append_array(validate_layout(layout))
	for pickup in families.get("pickups", []):
		problems.append_array(validate_pickup(pickup))
	for effect in families.get("effects", []):
		problems.append_array(validate_effect(effect))
	for active in families.get("actives", []):
		problems.append_array(validate_active(active))
	for table in families.get("drop_tables", []):
		problems.append_array(validate_drop_table(table))
	for theme in families.get("floors", []):
		problems.append_array(validate_floor(theme))
	for climb in families.get("climbs", []):
		problems.append_array(validate_climb(climb))
	for twist in families.get("twists", []):
		if twist.id not in FLOOR_TWISTS: problems.append("twist %s has no registered behaviour" % twist.id)
		if str(twist.get("name", "")).is_empty() or str(twist.get("line", "")).is_empty(): problems.append("twist %s needs a name and a line" % twist.id)
		if not is_number(twist.get("min_depth")) or twist.min_depth < 1: problems.append("twist %s needs a starting depth" % twist.id)
		if not is_number(twist.get("weight")) or twist.weight <= 0: problems.append("twist %s needs a positive weight" % twist.id)
	return problems

## A floor theme names only registered foes, bosses and hazards, and carries
## its words and colours whole.
func validate_floor(theme: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	for key in ["name", "epigraph", "lore"]:
		if str(theme.get(key, "")).strip_edges().is_empty(): problems.append("floor %s has no %s" % [theme.id, key])
	if theme.get("band") not in FLOOR_BANDS: problems.append("floor %s has unknown band '%s'" % [theme.id, theme.get("band")])
	var arrival = theme.get("arrival", [])
	if not arrival is Array or arrival.size() != 2: problems.append("floor %s needs a two-line arrival" % theme.id)
	var boss = theme.get("boss", {})
	if not boss is Dictionary or boss.get("kind", "") not in Foes.BOSSES: problems.append("floor %s has unknown boss '%s'" % [theme.id, boss.get("kind", "") if boss is Dictionary else boss])
	elif str(boss.get("name", "")).is_empty() or not boss.get("intro") is Array or boss.intro.size() != 2: problems.append("floor %s boss needs a name and a two-line introduction" % theme.id)
	var roster = theme.get("roster", [])
	if not roster is Array or roster.is_empty(): problems.append("floor %s has no roster" % theme.id)
	else:
		for entry in roster:
			if entry.is_empty(): problems.append("floor %s has a malformed roster entry" % theme.id)
			elif not Foes.known(entry[0]) or entry[0] in Foes.BOSSES: problems.append("floor %s roster names unknown foe '%s'" % [theme.id, entry[0]])
			elif entry[1] <= 0 or entry[2] < 1: problems.append("floor %s roster gives %s no chance" % [theme.id, entry[0]])
	if theme.get("hazard", "") not in FLOOR_HAZARDS: problems.append("floor %s has unknown hazard '%s'" % [theme.id, theme.get("hazard")])
	var look = theme.get("look", {})
	var floor_colors = look.get("floor", []) if look is Dictionary else []
	if not floor_colors is Array or floor_colors.size() != 5 or not floor_colors.all(func(c): return Color.html_is_valid(str(c))):
		problems.append("floor %s needs five floor colours" % theme.id)
	for key in FLOOR_LOOK_KEYS:
		if not look is Dictionary or not Color.html_is_valid(str(look.get(key, ""))): problems.append("floor %s has an invalid %s colour" % [theme.id, key])
	if not look is Dictionary or not is_number(look.get("candles")) or look.candles < 0 or look.candles > 3: problems.append("floor %s has an impossible candle density" % theme.id)
	var light = theme.get("light", {})
	if not light is Dictionary: problems.append("floor %s has a malformed light" % theme.id)
	else:
		for key in light:
			if key not in FLOOR_LIGHT_KEYS: problems.append("floor %s overrides unknown light '%s'" % [theme.id, key])
			elif not Color.html_is_valid(str(light[key])): problems.append("floor %s has an invalid %s" % [theme.id, key])
	var grade = theme.get("grade", {})
	if not grade is Dictionary: problems.append("floor %s has a malformed grade" % theme.id)
	else:
		for key in ["gain", "lift"]:
			if grade.has(key) and not Color.html_is_valid(str(grade[key])): problems.append("floor %s has an invalid grade %s" % [theme.id, key])
		if grade.has("saturation") and (not is_number(grade.saturation) or grade.saturation < 0 or grade.saturation > 2): problems.append("floor %s has an impossible saturation" % theme.id)
	var surface = look.get("surface", {}) if look is Dictionary else {}
	if not surface is Dictionary: problems.append("floor %s has a malformed surface" % theme.id)
	else:
		for key in surface:
			if key not in Look.SURFACE_KEYS: problems.append("floor %s surface has unknown '%s'" % [theme.id, key])
		if surface.get("pattern", "slabs") not in Look.PATTERNS: problems.append("floor %s surface has unknown pattern '%s'" % [theme.id, surface.get("pattern")])
		for key in ["grout", "ember_color", "moss_color"]:
			if surface.has(key) and not Color.html_is_valid(str(surface[key])): problems.append("floor %s surface has an invalid %s" % [theme.id, key])
	for twist in theme.get("exclude_twists", []):
		if twist not in FLOOR_TWISTS: problems.append("floor %s excludes unknown twist '%s'" % [theme.id, twist])
	return problems

## Every band of a climb must have enough themes for its places in it.
func validate_climb(climb: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if climb.has("fixed"):
		if not climb.fixed is Array or climb.fixed.is_empty(): problems.append("climb %s has no floors" % climb.id)
		else:
			for id in climb.fixed:
				if record("floors", id).is_empty(): problems.append("climb %s names missing floor '%s'" % [climb.id, id])
		return problems
	var bands = climb.get("bands", [])
	if not bands is Array or bands.size() < 2: problems.append("climb %s needs at least two floors" % climb.id)
	else:
		for band in FLOOR_BANDS:
			var needed = bands.count(band)
			var available = families.get("floors", []).filter(func(theme): return theme.band == band).size()
			if needed > available: problems.append("climb %s needs %d %s floors but %d exist" % [climb.id, needed, band, available])
		for band in bands:
			if band not in FLOOR_BANDS: problems.append("climb %s has unknown band '%s'" % [climb.id, band])
	return problems

static func is_number(value) -> bool:
	return value is float or value is int

func validate_prop(prop: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if prop.get("recipe") not in PROP_RECIPES: problems.append("prop %s has unknown visual recipe '%s'" % [prop.id, prop.get("recipe")])
	if prop.get("placement") not in PROP_PLACEMENTS: problems.append("prop %s has unknown placement '%s'" % [prop.id, prop.get("placement")])
	var size = prop.get("size", [])
	if not size is Array or size.size() != 2 or not is_number(size[0]) or not is_number(size[1]) or size[0] <= 0 or size[1] <= 0:
		problems.append("prop %s has an invalid footprint" % prop.id)
	if not is_number(prop.get("height")) or prop.height <= 0: problems.append("prop %s needs a positive height" % prop.id)
	if prop.get("detail") not in ["essential", "decor"]: problems.append("prop %s has an unknown detail class" % prop.id)
	# Lowering Small details may hide decoration, never collision or loot.
	if prop.get("detail") == "decor" and (prop.get("solid", false) or prop.has("breakable")):
		problems.append("decorative prop %s cannot be solid or breakable" % prop.id)
	if prop.get("blocks_shots", false) and not prop.get("solid", false): problems.append("prop %s blocks shots but is not solid" % prop.id)
	if prop.has("breakable"):
		var breakable = prop.breakable
		if not is_number(breakable.get("health")) or breakable.health <= 0: problems.append("prop %s needs positive break health" % prop.id)
		if not by_id.get("drop_tables", {}).has(breakable.get("drops", "")): problems.append("prop %s names missing drop table '%s'" % [prop.id, breakable.get("drops", "")])
		if not prop.get("blocks_shots", false): problems.append("breakable prop %s must be hittable" % prop.id)
	return problems

func validate_layout(layout: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	for role in layout.get("roles", []):
		if role not in ROOM_ROLES: problems.append("layout %s has unknown role '%s'" % [layout.id, role])
	for piece in layout.get("pieces", []):
		if not by_id.get("furniture", {}).has(piece.get("prop", "")): problems.append("layout %s names missing prop '%s'" % [layout.id, piece.get("prop", "")])
		var count = piece.get("count", [])
		if not count is Array or count.size() != 2 or count[0] < 0 or count[0] > count[1]: problems.append("layout %s has an impossible count" % layout.id)
		for companion in piece.get("with", []):
			if not by_id.get("furniture", {}).has(companion): problems.append("layout %s names missing companion '%s'" % [layout.id, companion])
	return problems

static func valid_range(value) -> bool:
	return value is Array and value.size() == 2 and is_number(value[0]) and is_number(value[1]) and value[0] >= 0 and value[0] <= value[1]

func validate_effect(effect: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if effect.get("channel") not in EFFECT_CHANNELS: problems.append("effect %s has unknown channel '%s'" % [effect.id, effect.get("channel")])
	if effect.get("spread") not in EFFECT_SPREADS: problems.append("effect %s has unknown spread '%s'" % [effect.id, effect.get("spread")])
	if not is_number(effect.get("count")) or effect.count < 1 or effect.count > 32: problems.append("effect %s has an impossible particle count" % effect.id)
	for key in ["speed", "lifetime", "size"]:
		if not valid_range(effect.get(key)): problems.append("effect %s has an invalid %s range" % [effect.id, key])
	if effect.has("lifetime") and valid_range(effect.lifetime) and (effect.lifetime[0] <= 0 or effect.lifetime[1] > 6): problems.append("effect %s lives too briefly or too long" % effect.id)
	if effect.get("color") != "inherit" and not Color.html_is_valid(str(effect.get("color", ""))): problems.append("effect %s has an invalid color" % effect.id)
	if effect.get("channel") == "ambient" and (not is_number(effect.get("rate")) or effect.rate <= 0): problems.append("ambient effect %s needs an emission rate" % effect.id)
	if effect.has("mark") and (not is_number(effect.mark.get("size")) or not is_number(effect.mark.get("lifetime")) or effect.mark.lifetime > 10): problems.append("effect %s has an invalid floor mark" % effect.id)
	return problems

## A painting needs its full provenance: the holding institution's record,
## the exact reproduction source and its rights basis, a credit line and an
## original caption. Imported files must also carry hashes and dimensions
## that match the expected composition.
func validate_painting(painting: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	for key in ["title", "artist", "date", "medium", "holding", "rights", "credit", "caption"]:
		if str(painting.get(key, "")).strip_edges().is_empty(): problems.append("painting %s has no %s" % [painting.id, key])
	if not str(painting.get("record_url", "")).begins_with("https://"): problems.append("painting %s has no institutional record" % painting.id)
	var source = painting.get("source", {})
	if not source is Dictionary or not SOURCE_TYPES.has(source.get("type", "")):
		problems.append("painting %s has no recognised reproduction source" % painting.id)
	else:
		if not str(source.get("page", "")).begins_with("https://"): problems.append("painting %s has no source page" % painting.id)
		if not source.has(SOURCE_TYPES[source.type]): problems.append("painting %s source lacks its %s" % [painting.id, SOURCE_TYPES[source.type]])
	if painting.get("verification") not in ["observed", "required"]: problems.append("painting %s has an unknown verification state" % painting.id)
	if not is_number(painting.get("aspect")) or painting.aspect < .2 or painting.aspect > 5: problems.append("painting %s has an impossible aspect ratio" % painting.id)
	var asset = painting.get("asset", {})
	if asset.get("status") not in ["pending", "imported"]:
		problems.append("painting %s has an unknown asset status" % painting.id)
	elif asset.status == "imported":
		for key in ["sha256_wall", "sha256_full"]:
			if not str(asset.get(key, "")).is_valid_hex_number() or str(asset.get(key, "")).length() != 64: problems.append("painting %s is missing its %s" % [painting.id, key])
		for key in ["retrieved", "revision", "image_url"]:
			if str(asset.get(key, "")).is_empty(): problems.append("painting %s is missing its %s" % [painting.id, key])
		if not is_number(asset.get("width")) or not is_number(asset.get("height")) or asset.width <= 0 or asset.height <= 0:
			problems.append("painting %s has no recorded dimensions" % painting.id)
		elif absf(float(asset.width) / asset.height / painting.aspect - 1.0) > .03:
			problems.append("painting %s file does not match its composition's aspect" % painting.id)
	return problems

func validate_collection(collection: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var ids: Array = collection.get("paintings", [])
	if ids.is_empty(): problems.append("collection %s has no paintings" % collection.id)
	var seen := {}
	for id in ids:
		if seen.has(id): problems.append("collection %s repeats %s" % [collection.id, id])
		seen[id] = true
		var painting = by_id.get("paintings", {}).get(id, {})
		if painting.is_empty(): problems.append("collection %s names missing painting '%s'" % [collection.id, id])
		elif painting.verification != "observed": problems.append("collection %s includes unverified painting '%s'" % [collection.id, id])
	var weapon = collection.get("unlocks", {}).get("weapon", "")
	if weapon != "":
		if not weapon_by_id.has(weapon): problems.append("collection %s unlocks missing weapon '%s'" % [collection.id, weapon])
		elif weapon_by_id[weapon].get("requires", "") != collection.id: problems.append("collection %s reward is not gated by it" % collection.id)
	return problems

func validate_pickup(pickup: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	if pickup.get("kind") not in PICKUP_KINDS: problems.append("pickup %s has unknown kind '%s'" % [pickup.id, pickup.get("kind")])
	if pickup.get("visual") not in PICKUP_VISUALS: problems.append("pickup %s has unknown visual '%s'" % [pickup.id, pickup.get("visual")])
	if not is_number(pickup.get("value")) or pickup.value <= 0: problems.append("pickup %s needs a positive value" % pickup.id)
	if pickup.has("cap") and (not is_number(pickup.cap) or pickup.cap < pickup.get("value", 0)): problems.append("pickup %s has an impossible cap" % pickup.id)
	if not Color.html_is_valid(str(pickup.get("color", ""))): problems.append("pickup %s has an invalid color" % pickup.id)
	return problems

func validate_active(active: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var handler = active.get("handler", "")
	if not ACTIVE_HANDLERS.has(handler):
		problems.append("active %s has unknown handler '%s'" % [active.id, handler])
		return problems
	if str(active.get("name", "")).is_empty() or str(active.get("description", "")).is_empty(): problems.append("active %s needs a name and description" % active.id)
	if not is_number(active.get("cooldown")) or active.cooldown <= 0: problems.append("active %s needs a positive cooldown" % active.id)
	var cost = active.get("cost", {})
	if not cost is Dictionary:
		problems.append("active %s has a malformed cost" % active.id)
	else:
		for resource in cost:
			if resource != "coins": problems.append("active %s costs an unknown resource '%s'" % [active.id, resource])
			elif not is_number(cost[resource]) or cost[resource] < 0 or cost[resource] > 99 or float(cost[resource]) != floorf(cost[resource]):
				problems.append("active %s has an impossible cost" % active.id)
	var params = active.get("params", {})
	for key in ACTIVE_HANDLERS[handler]:
		if not params.has(key): problems.append("active %s handler %s needs param '%s'" % [active.id, handler, key])
	if handler == "modifier":
		for stat in params.get("effects", {}):
			if not base_stats().has(stat): problems.append("active %s modifies unknown stat '%s'" % [active.id, stat])
	if not Color.html_is_valid(str(active.get("color", ""))): problems.append("active %s has an invalid color" % active.id)
	return problems

func validate_drop_table(table: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var rolls = table.get("rolls", [])
	if not rolls is Array or rolls.is_empty():
		problems.append("drop table %s has no rolls" % table.id)
		return problems
	for roll in rolls:
		var shapes = ["coins", "pickup", "one_of", "active"].filter(func(key): return roll.has(key))
		if shapes.size() != 1:
			problems.append("drop table %s has a roll that is not exactly one kind" % table.id)
			continue
		if roll.has("chance") and (not is_number(roll.chance) or roll.chance < 0 or roll.chance > 1): problems.append("drop table %s has an impossible chance" % table.id)
		if roll.has("count") and (not is_number(roll.count) or roll.count < 1): problems.append("drop table %s has an impossible count" % table.id)
		if roll.has("pickup") and not by_id.get("pickups", {}).has(roll.pickup): problems.append("drop table %s names missing pickup '%s'" % [table.id, roll.pickup])
		if roll.has("coins") and (not is_number(roll.coins) or roll.coins <= 0): problems.append("drop table %s has an impossible coin amount" % table.id)
		if roll.has("active") and (not is_number(roll.active) or roll.active < 0 or roll.active > 1): problems.append("drop table %s has an impossible active chance" % table.id)
		for choice in roll.get("one_of", []):
			if not by_id.get("pickups", {}).has(choice.get("pickup", "")): problems.append("drop table %s names missing pickup '%s'" % [table.id, choice.get("pickup", "")])
			if not is_number(choice.get("weight")) or choice.weight <= 0: problems.append("drop table %s has a non-positive weight" % table.id)
	return problems

func validate_template(template: Dictionary) -> PackedStringArray:
	var problems := PackedStringArray()
	var cells: Array = template.cells
	if cells.is_empty():
		problems.append("room %s has no footprint cells" % template.id)
		return problems
	var seen := {}
	for cell in cells:
		if seen.has(cell): problems.append("room %s repeats cell %s" % [template.id, cell])
		seen[cell] = true
	# Every cell must join the others through a shared edge.
	var reached := {cells[0]: true}
	var queue: Array = [cells[0]]
	while not queue.is_empty():
		var at: Vector2i = queue.pop_back()
		for step in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			if seen.has(at + step) and not reached.has(at + step):
				reached[at + step] = true
				queue.append(at + step)
	if reached.size() != seen.size(): problems.append("room %s footprint is not edge-connected" % template.id)
	if template.rotations.is_empty(): problems.append("room %s allows no rotation" % template.id)
	for rotation in template.rotations:
		if rotation < 0 or rotation > 3: problems.append("room %s has invalid rotation %d" % [template.id, rotation])
	if template.weight <= 0: problems.append("room %s has no generation weight" % template.id)
	for role in template.get("roles", []):
		if role not in ROOM_ROLES: problems.append("room %s has unknown role '%s'" % [template.id, role])
	for anchor in template.lights + [template.pedestal]:
		if not seen.has(anchor.cell): problems.append("room %s anchor lies outside its footprint" % template.id)
	return problems

const ROOM_ROLES := ["start", "combat", "treasure", "shop", "rest", "boss", "secret", "dark"]

static func to_cells(values: Array) -> Array:
	var result: Array = []
	for value in values:
		result.append(Vector2i(int(value[0]), int(value[1])))
	return result

## [cell x, cell y, u, v]; u/v are -1..1 fractions of the cell half extents.
static func to_anchor(value: Array) -> Dictionary:
	return {"cell": Vector2i(int(value[0]), int(value[1])), "offset": Vector2(float(value[2]), float(value[3]))}

func record(family: String, id: String) -> Dictionary:
	return by_id.get(family, {}).get(id, {})

## Stable 32-bit FNV-1a, used for named seed streams and content revisions.
## Unlike engine hashing it is documented and identical on every platform.
static func stable_hash(text: String) -> int:
	var value := 2166136261
	for byte in text.to_utf8_buffer():
		value = ((value ^ byte) * 16777619) & 0xffffffff
	return value

func roll_items(rng: RandomNumberGenerator, count: int, owned: Array = [], premium := false, luck_value := 0.0) -> Array:
	var result: Array = []
	# Dark relics are only ever sold in the dark store.
	var pool: Array = items.filter(func(item): return item.rarity != "dark")
	for unused in count:
		var weights: Array[float] = []
		var total = 0.0
		for item in pool:
			var weight: float = {"common": 6.0, "uncommon": 3.5, "rare": 1.2, "mythic": 0.25}[item.rarity]
			if premium and item.rarity in ["rare", "mythic"]:
				weight *= 4.0
			if item.rarity in ["rare", "mythic"]:
				weight *= 1.0 + maxf(0, luck_value) * .3
			if item.id in owned:
				weight *= 0.25
			total += weight
			weights.append(total)
		var roll = rng.randf() * total
		for i in pool.size():
			if roll <= weights[i]:
				result.append(pool.pop_at(i))
				break
	return result

