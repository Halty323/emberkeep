; Emberkeep — Godot 4.6 / native Android prototype
config_version=5

[application]
config/name="Emberkeep"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="A cozy, isometric dungeon roguelike. Every little light fights back."
config/icon="res://assets/icon.svg"

[autoload]
Content="*res://scripts/content.gd"
Settings="*res://scripts/settings_service.gd"
Run="*res://scripts/run.gd"
Collection="*res://scripts/progression/collection_service.gd"
Audio="*res://scripts/audio.gd"
Session="*res://scripts/session.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/use_anisotropic_filter=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=0
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.045, 1)
anti_aliasing/quality/msaa_3d=1

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=0.0

[audio]
driver/enable_input=false

[importer_defaults]

texture={
"mipmaps/generate": true,
"compress/mode": 2,
"process/size_limit": 2048
}

[shader_globals]

room_footprint={
"type": "sampler2D",
"value": ""
}
room_grid_origin={
"type": "vec2",
"value": Vector2(-9, -7)
}
room_grid_cells={
"type": "vec2",
"value": Vector2(1, 1)
}

[editor]
version_control/autoload_on_startup=false
